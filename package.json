{
  "name": "pos-system",
  "version": "1.0.0",
  "description": "Smart Buy POS — Offline-First POS System",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "database"
  ],
  "scripts": {
    "start": "npm run start:web",
    "start:web": "concurrently -n \"BACKEND,VITE\" -c \"cyan,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start:electron": "concurrently -n \"BACKEND,ELECTRON\" -c \"cyan,green\" \"npm run dev:backend\" \"npm run dev:electron\"",
    "dev": "npm run start:web",
    "docker:up": "docker compose --env-file .env.docker up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "cd frontend && npm run electron:dev",
    "db:migrate": "cd database && npm run migrate",
    "db:seed": "cd database && npm run seed",
    "db:generate": "cd database && npm run generate",
    "db:studio": "cd database && npm run studio",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ../database && npm install",
    "build": "cd frontend && npm run build",
    "build:win": "cd frontend && npm run build:win"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^44.0.0"
  }
}
